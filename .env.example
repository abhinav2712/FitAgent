# --- Database ---
DATABASE_URL=postgresql+psycopg2://fitagent:fitagent@db:5432/fitagent

# --- Security ---
# No shared secret: every request (tracker + iPhone Shortcut) carries a per-user
# X-Api-Token, minted by `python -m app.create_user "<name>"`.

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-4-6          # strong model for plan patches
CLASSIFIER_MODEL=claude-haiku-4-5-20251001  # cheap model for intent classification

# --- Telegram ---
# One bot serves all users; each user's chat id lives in the users table
# (set it via `python -m app.create_user "<name>" --chat-id <id>`).
TELEGRAM_BOT_TOKEN=123456:ABC...       # from @BotFather

# --- Swiggy MCP (fill after approval at mcp.swiggy.com/builders) ---
SWIGGY_MCP_URL=
SWIGGY_MCP_TOKEN=
SWIGGY_MOCK=true                       # true = use built-in mock dishes until approved

# --- Deployment constants ---
USER_TZ=Asia/Kolkata     # worker cron timezone, shared by all users (per-user tz is v2)
USER_LAT=12.97           # Swiggy search fallback; per-user lat/lng live in the users table
USER_LNG=77.59
