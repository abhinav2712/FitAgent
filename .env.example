# --- Database ---
DATABASE_URL=postgresql+psycopg2://fitagent:fitagent@db:5432/fitagent

# --- Security ---
# No shared secret: every request (tracker + iPhone Shortcut) carries a per-user
# X-Api-Token, minted by `python -m app.create_user "<name>"`.

# --- LLM ---
# Option A (paid): official Claude API
ANTHROPIC_API_KEY=sk-ant-...           # from console.anthropic.com
ANTHROPIC_BASE_URL=                    # empty = api.anthropic.com
AGENT_MODEL=claude-sonnet-4-6          # strong model for plan patches
CLASSIFIER_MODEL=claude-haiku-4-5-20251001  # cheap model for intent classification
# Option B (free, local): Ollama's Anthropic-compatible API — run `ollama serve`,
# pull a tool-calling model, then:
# ANTHROPIC_API_KEY=ollama             # any non-empty string
# ANTHROPIC_BASE_URL=http://host.docker.internal:11434   # localhost:11434 outside Docker
# AGENT_MODEL=gemma4:e4b               # or qwen3:8b etc. — must support tool calling
# CLASSIFIER_MODEL=gemma4:e4b

# --- Telegram ---
# One bot serves all users; each user's chat id lives in the users table
# (set it via `python -m app.create_user "<name>" --chat-id <id>`).
TELEGRAM_BOT_TOKEN=123456:ABC...       # from @BotFather

# --- Swiggy MCP ---
# Real mode needs each user to link their Swiggy account once (phone + OTP):
#   python -m app.swiggy_auth <user_id>
# The 5-day OAuth token lands on that user's row; then set SWIGGY_MOCK=false.
SWIGGY_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_MOCK=true                       # true = built-in mock dishes (no account needed)

# --- Deployment constants ---
USER_TZ=Asia/Kolkata     # worker cron timezone, shared by all users (per-user tz is v2)
USER_LAT=12.97           # Swiggy search fallback; per-user lat/lng live in the users table
USER_LNG=77.59
